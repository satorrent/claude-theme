{
  "name": "contrast-themes-for-claude-ai",
  "version": "0.1.0",
  "description": "Unofficial Chrome extension with high-contrast color themes for the claude.ai website.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20.10"
  }
}
