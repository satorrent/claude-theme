{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrast Themes theme",
  "description": "A color theme for the Contrast Themes extension. Only the input colors are required: light and dark tokens are generated from them (with WCAG AA contrast checks) when missing.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "source",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema, for editor autocompletion."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Version of this schema. Bumped only on breaking changes."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40,
      "description": "Unique id in kebab-case. For files in /themes it must match the file name."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Display name."
    },
    "author": {
      "type": "string",
      "maxLength": 60,
      "description": "Optional author name or handle."
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "Optional one-line description."
    },
    "source": {
      "enum": [
        "preset",
        "manual",
        "image"
      ],
      "description": "How the theme was created."
    },
    "inputs": {
      "type": "object",
      "required": [
        "base",
        "accent"
      ],
      "additionalProperties": false,
      "description": "Colors the tokens are generated from.",
      "properties": {
        "base": {
          "$ref": "#/$defs/hex",
          "description": "Sets the hue and tint of backgrounds and text."
        },
        "accent": {
          "$ref": "#/$defs/hex",
          "description": "Drives buttons, links and focus rings."
        },
        "tint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly backgrounds take the base color: 0 = neutral grays, 1 = strongest. Defaults to 0.6."
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hex"
          },
          "minItems": 1,
          "maxItems": 8,
          "description": "Colors extracted from a reference image (only for source 'image')."
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "additionalProperties": false,
      "description": "Generated tokens. Optional in /themes files: the build and the extension generate them from inputs.",
      "properties": {
        "light": {
          "$ref": "#/$defs/tokenSet"
        },
        "dark": {
          "$ref": "#/$defs/tokenSet"
        }
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Six-digit hex color, e.g. #c2410c."
    },
    "tokenSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg",
        "surfaceLow",
        "surface",
        "surfaceRaised",
        "popover",
        "text",
        "textSecondary",
        "textMuted",
        "accent",
        "accentHover",
        "onAccent",
        "accentText",
        "accentSoft",
        "border",
        "borderStrong",
        "danger",
        "success",
        "warning"
      ],
      "properties": {
        "bg": {
          "$ref": "#/$defs/hex"
        },
        "surfaceLow": {
          "$ref": "#/$defs/hex"
        },
        "surface": {
          "$ref": "#/$defs/hex"
        },
        "surfaceRaised": {
          "$ref": "#/$defs/hex"
        },
        "popover": {
          "$ref": "#/$defs/hex"
        },
        "text": {
          "$ref": "#/$defs/hex"
        },
        "textSecondary": {
          "$ref": "#/$defs/hex"
        },
        "textMuted": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "accentHover": {
          "$ref": "#/$defs/hex"
        },
        "onAccent": {
          "$ref": "#/$defs/hex"
        },
        "accentText": {
          "$ref": "#/$defs/hex"
        },
        "accentSoft": {
          "$ref": "#/$defs/hex"
        },
        "border": {
          "$ref": "#/$defs/hex"
        },
        "borderStrong": {
          "$ref": "#/$defs/hex"
        },
        "danger": {
          "$ref": "#/$defs/hex"
        },
        "success": {
          "$ref": "#/$defs/hex"
        },
        "warning": {
          "$ref": "#/$defs/hex"
        }
      }
    }
  }
}
